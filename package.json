{
  "name": "unplugin-mockery",
  "type": "module",
  "version": "0.4.0-beta.2",
  "packageManager": "pnpm@10.13.1",
  "description": "",
  "license": "MIT",
  "homepage": "https://github.com/YunYouJun/unplugin-mockery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/unplugin-mockery.git"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/unplugin-mockery/issues"
  },
  "keywords": [
    "unplugin",
    "vite",
    "webpack",
    "rollup",
    "transform"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget": {
      "types": "./widget/dist/index.d.ts",
      "import": "./widget/dist/index.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "require": "./dist/astro.cjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "require": "./dist/rspack.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js",
      "require": "./dist/rollup.cjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js",
      "require": "./dist/esbuild.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "client/dist",
    "dist",
    "dist-client",
    "widget/dist"
  ],
  "scripts": {
    "build": "npm run build:unplugin && npm run build:client && npm run build:widget",
    "build:unplugin": "tsdown",
    "build:client": "pnpm -C packages/client run build",
    "build:widget": "pnpm -C packages/widget run build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "dev": "tsdown --watch src",
    "dev:client": "pnpm -C packages/client run dev",
    "build:fix": "esno scripts/postbuild.ts",
    "lint": "eslint .",
    "play": "npm -C playground run dev",
    "play:webpack": "pnpm -C playground/webpack run serve",
    "play:vite": "pnpm -C playground/vite run dev",
    "play:vue-cli": "pnpm -C playground/vue-cli run serve",
    "play:nuxt": "pnpm -C playground/nuxt run dev",
    "prepublishOnly": "npm run build",
    "release": "bumpp --execute 'npm run changelog' --all",
    "release:local": "bump --no-commit --no-tag && npm publish",
    "release:local:beta": "bumpp --no-commit --no-tag && npm publish --tag beta",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3",
    "@nuxt/schema": "^3",
    "esbuild": "*",
    "rollup": "^3",
    "vite": ">=3",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.39.3",
    "@rollup/pluginutils": "^5.2.0",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.0.7",
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "consola": "^3.4.2",
    "define-config-ts": "^0.0.3",
    "defu": "^6.1.4",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "get-port-please": "^3.2.0",
    "launch-editor": "^2.10.0",
    "lowdb": "^7.0.1",
    "micromatch": "^4.0.8",
    "msw": "^2.10.4",
    "open": "^10.2.0",
    "path-to-regexp": "^8.2.0",
    "picocolors": "^1.1.1",
    "serve-static": "^2.2.0",
    "unplugin": "^2.3.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@nuxt/kit": "^4.0.1",
    "@nuxt/schema": "^4.0.1",
    "@trpc/client": "11.4.3",
    "@trpc/server": "11.4.3",
    "@types/escape-html": "^1.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^24.1.0",
    "@unocss/eslint-config": "^66.3.3",
    "bumpp": "^10.2.0",
    "chalk": "^5.4.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-format": "^1.0.1",
    "esno": "^4.8.0",
    "monaco-editor": "^0.52.2",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "rollup": "^4.45.1",
    "sass": "^1.89.2",
    "simple-git-hooks": "^2.13.0",
    "tsdown": "^0.13.0",
    "typescript": "^5.8.3",
    "vite": "catalog:build",
    "vitest": "^3.2.4",
    "webpack": "^5.100.2",
    "zod": "^4.0.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
